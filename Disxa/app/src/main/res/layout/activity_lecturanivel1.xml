<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F0E8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <Button
            android:id="@+id/button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#00FFFFFF"
            android:onClick="regresar"
            android:text="@string/regresar"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold"
            app:icon="@mipmap/buton"
            app:iconSize="40dp"
            app:iconTintMode="multiply" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:text="Lectura Nivel 1"
            android:textColor="#3D2B1F"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"
            android:text="Lee el texto en voz alta"
            android:textColor="#8D6E63"
            android:textSize="14sp"/>

        <!-- Tarjeta principal: texto + GIF lado a lado -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardElevation="6dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <!-- Texto con colores (ocupa la mayor parte) -->
                <TextView
                    android:id="@+id/tvHighlightedText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-light"
                    android:lineSpacingMultiplier="1.7"
                    android:paddingEnd="12dp"
                    android:textColor="#2C3E50"
                    android:textSize="20sp" />

                <!-- GIF del personaje al lado derecho -->
                <ImageView
                    android:id="@+id/gifPersonaje"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:scaleType="centerCrop"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Leyenda de colores -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="10dp">

            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/dot_green"
                android:layout_gravity="center_vertical"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  Correcto    "
                android:textColor="#8D6E63"
                android:textSize="12sp"/>

            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/dot_red"
                android:layout_gravity="center_vertical"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  Incorrecto"
                android:textColor="#8D6E63"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Barra de estado -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="#FFF3E0"
            app:cardElevation="2dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:gravity="center"
                android:text="Presiona el micrófono para comenzar"
                android:textColor="#E65100"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3"/>
        </androidx.cardview.widget.CardView>

        <!-- Botón micrófono centrado -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp">

            <!-- Anillo pulsante -->
            <View
                android:id="@+id/micPulseRing"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:background="@drawable/mic_pulse_ring"
                android:visibility="invisible"/>

            <!-- Botón micrófono -->
            <ImageButton
                android:id="@+id/btnMicrophone"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:contentDescription="Micrófono"
                android:elevation="6dp"
                android:padding="18dp" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:text="Toca para hablar"
            android:textColor="#050505"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Botón reset -->
        <Button
            android:id="@+id/btnReset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#59CE52"
            android:text="↺  Reiniciar"
            android:textColor="#000000"
            android:textColorLink="#00FFFFFF"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>